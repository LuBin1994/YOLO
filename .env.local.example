# =============================================================
# 复制本文件为 .env.local 并填入真实值
# cp .env.local.example .env.local
# =============================================================

# Supabase 项目凭据（Supabase Dashboard → Settings → API）
# 注意：NEXT_PUBLIC_ 前缀的变量会暴露到浏览器，anon key 是公开的，安全由 RLS 保障
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 后台初始管理员邮箱（用于手动创建管理员记录，见 README）
NEXT_PUBLIC_ADMIN_EMAIL= 

# =============================================================
# QQ 邮箱 SMTP（询盘自动回复邮件）
# 1. 打开 QQ 邮箱网页版 → 设置 → 账户 → 开启「SMTP 服务」
#    生成 16 位「授权码」（不是 QQ 登录密码）
# 2. SMTP_USER 填你的 QQ 邮箱，SMTP_PASS 填授权码
# 3. 注意：QQ 邮箱免费号每天发信有限额，网站访问量大时可能被限
# =============================================================
SMTP_HOST=1
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# =============================================================
# Vercel Web Analytics（后台数据看板 /admin）
#
# VERCEL_TOKEN 需手动创建：Vercel Dashboard → Settings → Tokens → Create
#
# 【容易踩坑】VERCEL_PROJECT_ID / VERCEL_TEAM_ID 是 Vercel 的「系统环境变量」，
# 只在 Vercel 平台上的构建与运行时注入。本地 `next dev` 拿不到，
# 必须在这里手动填写，否则看板只会显示「尚未配置」。
#   VERCEL_PROJECT_ID  项目 Settings → General → Project ID（prj_ 开头）
#   VERCEL_TEAM_ID     仅团队项目需要（team_ 开头）；个人账号留空不写
#
# 另注意：.env.local 已被 .gitignore 排除（.env*），不会同步到 Vercel。
# 线上运行时要在 Project → Settings → Environment Variables 里单独配 VERCEL_TOKEN。
# =============================================================
# VERCEL_TOKEN=your_vercel_access_token
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
# VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx

# Supabase Auth 重定向地址（登录回调，本地调试用 http://localhost:3000）
# Supabase Dashboard → Authentication → URL Configuration 中配置：
#   Site URL:        https://your-domain.com
#   Redirect URLs:   http://localhost:3000/** , https://your-domain.com/**
